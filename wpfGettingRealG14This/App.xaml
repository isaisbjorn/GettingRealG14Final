<Application x:Class="wpfGettingRealG14This.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Application.Resources>

		<!-- Stil til menuknapper i venstre panel -->
		<Style x:Key="MenuKnap" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#BDC3C7"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Light"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="24,14"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Style.Triggers>
				<!-- Når musen er over knappen bliver den lysere -->
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#2F3640"/>
					<Setter Property="Foreground" Value="White"/>
				</Trigger>
			</Style.Triggers>
		</Style>

	</Application.Resources>
</Application>