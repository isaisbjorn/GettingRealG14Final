<!--
    ResizeMode="NoResize" forhindrer brugeren i at ændre vinduesstørrelsen
    WindowStartupLocation="CenterScreen" åbner vinduet midt på skærmen
-->
<Window x:Class="wpfGettingRealG14This.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ManuVision — Log ind"
        Height="420" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

	<!--
        Hele baggrunden er en mørkegrå farve
        inspireret af hjemmesidens farvetema
    -->
	<Grid Background="#2F3640">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="7*"/>
			<ColumnDefinition Width="373*"/>
		</Grid.ColumnDefinitions>

		<!--
            En hvid kortlignende boks centreret i midten
            VerticalAlignment og HorizontalAlignment="Center"
            placerer den midt i det grå baggrundslag
        -->
		<Border Background="White"
                CornerRadius="8"
                Padding="36,32"
                Width="300"
                VerticalAlignment="Center"
                HorizontalAlignment="Left" Grid.Column="1" Margin="33,0,0,0">

			<StackPanel>

				<!--
                    Logo-tekst øverst
                    Vi bruger to TextBlocks til at efterligne
                    det layout vi har på wireframet
                -->
				<TextBlock Text="ManuVision"
                           FontSize="26"
                           FontWeight="Light"
                           Foreground="#2F3640"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>
				<TextBlock Text="Kropsbehandling"
                           FontSize="16"
                           FontWeight="Light"
                           Foreground="#7F8C8D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

				<!-- Sign in overskrift -->
				<TextBlock Text="Log in"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#2F3640"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
				<Label Content="Brugernavn"/>

				<!-- Brugernavnsfelt -->
				<TextBox x:Name="BrugernavnFelt"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,10"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1">
					<!--
                       Bruges ikke alligevel, men gemmer lige hvis vi skifter 
                       mening eller skal bruge skabelonen et andet sted
                       Placeholder-tekst — vises når feltet er tomt
                        Når brugeren klikker forsvinder den
                    -->
					<TextBox.Style>
						<Style TargetType="TextBox">
							<Style.Triggers>
								<Trigger Property="Text" Value="">
									<Setter Property="Background">
										<Setter.Value>
											<VisualBrush Stretch="None" AlignmentX="Left">
												<VisualBrush.Visual>
													<TextBlock Text=""
                                                               Foreground="#BDC3C7"
                                                               FontSize="14"
                                                               Margin="12,8"/>
												</VisualBrush.Visual>
											</VisualBrush>
										</Setter.Value>
									</Setter>
								</Trigger>
							</Style.Triggers>
						</Style>
					</TextBox.Style>
				</TextBox>
				<Label Content="Password"/>

				<!--
                    PasswordBox er en speciel WPF-kontrol til kodeord
                    Den viser prikker i stedet for bogstaver
                    Den kan IKKE bindes direkte via {Binding} af sikkerhedsgrunde
                    Vi henter værdien manuelt i code-behind i stedet
                    x:Name giver den et navn vi kan referere til i code-behind
                -->
				<PasswordBox x:Name="KodeFelt"
                             FontSize="14"
                             Padding="10,8"
                             Margin="0,0,0,16"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"/>
				<Button Content="Log in"
                        Command="{Binding LoginCommand}"
                        Click="LoginKnap_Click"
                        FontSize="14"
                        Padding="0,10"
                        Background="#5D6D7E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

				<!--
                    Fejlbesked — vises kun hvis FejlBesked ikke er tom
                    Visibility="{Binding FejlBesked, Converter=...}" 
                    ville kræve en Converter — vi holder det simpelt her
                    og viser den altid men med tom tekst når der ingen fejl er
                -->
				<TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E74C3C"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

				<!--
                    Login-knappen
                    Command binder til LoginCommand i ViewModel
                    Click kalder også en metode i code-behind
                    fordi vi skal sende koden fra PasswordBox til ViewModel
                    inden ViewModel tjekker login
                -->

			</StackPanel>
		</Border>
	</Grid>
</Window>