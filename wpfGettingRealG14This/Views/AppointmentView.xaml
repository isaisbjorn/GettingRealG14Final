<!--
    AppointmentView.xaml
    Aftale-vinduet — her kan man oprette nye aftaler.

    Layout: to kolonner
      Venstre (300px, mørk) — formular til at oprette aftale
      Højre (* , lys)       — oversigt over alle eksisterende aftaler
-->
<Window x:Class="wpfGettingRealG14This.Views.AppointmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ManuVision — Aftaler"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Venstre: opret-formular -->
            <ColumnDefinition Width="300"/>
            <!-- Tynd skillelinje -->
            <ColumnDefinition Width="1"/>
            <!-- Højre: aftaleoversigt -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================== -->
        <!-- VENSTRE: OPRET FORMULAR    -->
        <!-- ========================== -->
        <Border Grid.Column="0"
                Background="#1E272E"
                Padding="24">
            <StackPanel>

                <!-- Tilbage-knap -->
                <Button Content="← Tilbage til menu"
                        Click="TilbageKnap_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7F8C8D"
                        FontSize="12"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"/>

                <TextBlock Text="Opret aftale"
                           FontSize="20"
                           FontWeight="Light"
                           Foreground="White"
                           Margin="0,0,0,24"/>

                <!-- KLIENT-DROPDOWN -->
                <!--
                    ComboBox viser listen af klienter fra ViewModel.
                    SelectedItem binder til SelectedClient — når brugeren vælger
                    en klient, opdaterer ViewModel automatisk forløbs-listen.
                    DisplayMemberPath viser klientens fornavn direkte.
                -->
                <TextBlock Text="Klient"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Clients}"
                          SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="FirstName"
                          Margin="0,0,0,14"
                          Padding="8,6"
                          Background="#2F3640"
                          Foreground="#2F3640"
                          BorderBrush="#5D6D7E"/>

                <!-- BEHANDLINGSFORLØB-DROPDOWN -->
                <!--
                    Fyldes automatisk med forløbene for den valgte klient.
                    DisplayMemberPath="Issue" viser forløbets beskrivelse direkte.
                -->
                <TextBlock Text="Behandlingsforløb"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Courses}"
                          SelectedItem="{Binding SelectedCourse}"
                          DisplayMemberPath="Issue"
                          Margin="0,0,0,14"
                          Padding="8,6"
                          Background="#2F3640"
                          Foreground="#2F3640"
                          BorderBrush="#5D6D7E"/>

                <!-- DATO -->
                <!--
                    DatePicker er en WPF-kontrol med en kalender til at vælge dato.
                    SelectedDate binder til SelectedDate (DateTime) i ViewModel.
                -->
                <TextBlock Text="Dato"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding SelectedDate}"
                            Margin="0,0,0,14"
                            Padding="6,4"
                            Background="#2F3640"
                            BorderBrush="#5D6D7E"/>

                <!-- STARTTID -->
                <TextBlock Text="Starttid  (HH:mm)"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,14"
                         BorderBrush="#5D6D7E"
                         BorderThickness="1"
                         Background="#2F3640"
                         Foreground="White"
                         CaretBrush="White"/>

                <!-- SLUTTID -->
                <TextBlock Text="Sluttid  (HH:mm)"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,20"
                         BorderBrush="#5D6D7E"
                         BorderThickness="1"
                         Background="#2F3640"
                         Foreground="White"
                         CaretBrush="White"/>

                <!--
                    Fejlbesked — vises med rød tekst hvis noget gik galt
                    Bekræftelse — vises med grøn tekst når aftalen er gemt
                -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E74C3C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Confirmation}"
                           Foreground="#2ECC71"
                           FontSize="12"
                           Margin="0,0,0,12"/>

                <!--
                    Opret-knappen er kun aktiv når alle felter er udfyldt.
                    CanCreateAppointment() i ViewModel bestemmer dette.
                -->
                <Button Content="Opret aftale"
                        Command="{Binding CreateAppointmentCommand}"
                        FontSize="14"
                        Padding="0,12"
                        Background="#5D6D7E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

            </StackPanel>
        </Border>

        <!-- Lodret skillelinje -->
        <Border Grid.Column="1" Background="#E0E0E0"/>

        <!-- ========================== -->
        <!-- HØJRE: AFTALEOVERSIGT      -->
        <!-- ========================== -->
        <Border Grid.Column="2"
                Background="White"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Alle aftaler"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#2F3640"
                           Margin="0,0,0,16"/>

                <!--
                    Liste over alle aftaler — AllAppointments er en
                    ObservableCollection<AppointmentDisplay> fra ViewModel.
                    Den opdateres automatisk efter en ny aftale oprettes.
                -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding AllAppointments}"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#F0F0F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!--
                        Hvert AppointmentDisplay-objekt vises med:
                          - Dato og tidspunkt øverst
                          - Klientnavn under
                    -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Dato formateret som "dd/MM/yyyy" -->
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#2F3640"
                                               Margin="0,0,10,0">
                                        <TextBlock.Text>
                                            <Binding Path="Date"
                                                     StringFormat="{}{0:dd/MM/yyyy}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TimeSlot}"
                                               FontSize="13"
                                               Foreground="#5D6D7E"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ClientName}"
                                           FontSize="12"
                                           Foreground="#7F8C8D"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Window>
