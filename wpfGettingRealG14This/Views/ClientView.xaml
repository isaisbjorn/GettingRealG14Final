<Window x:Class="wpfGettingRealG14This.Views.ClientView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ManuVision — Klienter"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

	<Grid>
		<Grid.ColumnDefinitions>
			<!-- Venstre side: liste og søgning -->
			<ColumnDefinition Width="*"/>
			<!-- Mellemrum -->
			<ColumnDefinition Width="1"/>
			<!-- Højre side: opret formular -->
			<ColumnDefinition Width="320"/>
		</Grid.ColumnDefinitions>

		<!-- ======================== -->
		<!-- VENSTRE: LISTE           -->
		<!-- ======================== -->
		<Border Grid.Column="0"
                Background="White"
                Padding="24">
			<StackPanel>

				<!-- Tilbage-knap — lukker dette vindue og viser velkomstskærmen igen -->
				<Button Content="← Tilbage til menu"
                        Click="TilbageKnap_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7F8C8D"
                        FontSize="12"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"/>

				<!-- Overskrift -->
				<TextBlock Text="Klienter"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#2F3640"
                           Margin="0,0,0,16"/>

				<!-- Søgefelt -->
				<TextBox Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,12"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         Tag="Søg på navn, telefon eller email...">
					<TextBox.Style>
						<Style TargetType="TextBox">
							<Style.Triggers>
								<Trigger Property="Text" Value="">
									<Setter Property="Background">
										<Setter.Value>
											<VisualBrush Stretch="None" AlignmentX="Left">
												<VisualBrush.Visual>
													<TextBlock Text="Søg på navn, telefon eller email..."
                                                               Foreground="#BDC3C7"
                                                               FontSize="14"
                                                               Margin="12,8"/>
												</VisualBrush.Visual>
											</VisualBrush>
										</Setter.Value>
									</Setter>
								</Trigger>
							</Style.Triggers>
						</Style>
					</TextBox.Style>
				</TextBox>

				<!--
                    Listen over klienter
                    ItemsSource binder til Clients i ViewModel
                    SelectedItem binder til SelectedClient i ViewModel
                    ScrollViewer.VerticalScrollBarVisibility giver en scrollbar
                    når listen er lang
                -->
				<ListBox ItemsSource="{Binding Clients}"
                         SelectedItem="{Binding SelectedClient}"
                         Height="380"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
					<ListBox.ItemContainerStyle>
						<!--
                            Stil på hvert listeelement
                            Fjerner den blå standardmarkering
                            og giver vores egen farve
                        -->
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="12,10"/>
							<Setter Property="BorderBrush" Value="#F0F0F0"/>
							<Setter Property="BorderThickness" Value="0,0,0,1"/>
							<Style.Triggers>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Background" Value="#EAF2FF"/>
									<Setter Property="Foreground" Value="#2F3640"/>
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#F5F6FA"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<!--
                                Hvert element viser fornavn + efternavn
                                samt telefonnummer under
                            -->
							<StackPanel>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding FirstName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#2F3640"
                                               Margin="0,0,6,0"/>
									<TextBlock Text="{Binding LastName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#2F3640"/>
								</StackPanel>
								<TextBlock Text="{Binding Phone}"
                                           FontSize="12"
                                           Foreground="#7F8C8D"
                                           Margin="0,2,0,0"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<!-- Slet-knap under listen -->
				<!-- Knap til at åbne klient-detaljevinduet — kun aktiv når en klient er valgt -->
				<Button Content="Se valgt klient"
                        Command="{Binding OpenDetailCommand}"
                        Margin="0,12,0,6"
                        Padding="12,8"
                        FontSize="13"
                        Background="#5D6D7E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left"/>

				<Button Content="Slet valgt klient"
                        Command="{Binding DeleteClientCommand}"
                        Margin="0,0,0,0"
                        Padding="12,8"
                        FontSize="13"
                        Background="#E74C3C"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left"/>

			</StackPanel>
		</Border>

		<!-- Lodret skillelinje -->
		<Border Grid.Column="1" Background="#E0E0E0"/>

		<!-- ======================== -->
		<!-- HØJRE: OPRET FORMULAR    -->
		<!-- ======================== -->
		<Border Grid.Column="2"
                Background="#1E272E"
                Padding="24">
			<StackPanel>

				<!-- Overskrift -->
				<TextBlock Text="Opret ny klient"
                           FontSize="20"
                           FontWeight="Light"
                           Foreground="White"
                           Margin="0,0,0,24"/>

				<!-- Fornavn -->
				<TextBlock Text="Fornavn"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
				<TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,14"
                         BorderBrush="#5D6D7E"
                         BorderThickness="1"
                         Background="#2F3640"
                         Foreground="White"
                         CaretBrush="White"/>

				<!-- Efternavn -->
				<TextBlock Text="Efternavn"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
				<TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,14"
                         BorderBrush="#5D6D7E"
                         BorderThickness="1"
                         Background="#2F3640"
                         Foreground="White"
                         CaretBrush="White"/>

				<!-- Telefon -->
				<TextBlock Text="Telefon"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
				<TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,14"
                         BorderBrush="#5D6D7E"
                         BorderThickness="1"
                         Background="#2F3640"
                         Foreground="White"
                         CaretBrush="White"/>

				<!-- Email -->
				<TextBlock Text="Email"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           Margin="0,0,0,4"/>
				<TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,24"
                         BorderBrush="#5D6D7E"
                         BorderThickness="1"
                         Background="#2F3640"
                         Foreground="White"
                         CaretBrush="White"/>

				<!--
                    Opret-knappen
                    Er kun aktiv når alle felter er udfyldt
                    KanOpretteClient() i ViewModel styrer dette
                -->
				<Button Content="Opret klient"
                        Command="{Binding CreateClientCommand}"
                        FontSize="14"
                        Padding="0,12"
                        Background="#5D6D7E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

			</StackPanel>
		</Border>

	</Grid>
</Window>
